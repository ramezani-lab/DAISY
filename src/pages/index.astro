---
import Base from '../layouts/Base.astro';
import Daisy from '../components/Daisy.astro';
import Diffusion from '../components/Diffusion.astro';
import SqlDemo from '../components/SqlDemo.astro';
import PubTimeline from '../components/PubTimeline.astro';
import PubItem from '../components/PubItem.astro';
import NewsItem from '../components/NewsItem.astro';
import EventItem from '../components/EventItem.astro';
import Avatar from '../components/Avatar.astro';
import { site, research, publications, people, load, events, byDateDesc, PROJECT_KINDS } from '../lib/data';
import credits from '../data/photo-credits.json';

const areas = await research();
const pubs = await publications();
const selected = pubs.filter((p) => p.data.selected).slice(0, 5);
const featured = selected.length ? selected : pubs.slice(0, 4);
const news = (await load('news')).sort(byDateDesc).slice(0, 4);
const { upcoming } = await events();
const { current, alumni } = await people();
const positions = (await load('positions')).filter((p) => p.data.status === 'open');
const projects = (await load('projects')).filter((p) => p.data.status === 'active').sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const campus = credits.find((c) => c.file.includes('campus-alborz'))!;
const count = (id: string) => pubs.filter((p) => p.data.areas.includes(id)).length;
---
<Base>
  <section class="hero">
    <Diffusion />
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>{site.name}</h1>
        <p class="statement">The {site.full_name} in the <a href={site.department_url}>{site.department}</a> at <a href={site.university_url}>{site.university}</a>.</p>
        <p class="intro">{site.intro}</p>
        <div class="cta">
          <a class="btn primary" href="/publications/">Read our publications</a>
          <a class="btn" href="/join/">Work with us</a>
        </div>
      </div>
      <div class="hero-art" data-tilt><Daisy /></div>
    </div>
  </section>

  <section class="section directions" data-reveal>
    <div class="wrap">
      <div class="section-head">
        <h2>Research directions</h2>
        <a class="more" href="/research/">All research</a>
      </div>
      <ul class="areas" data-stagger>
        {areas.map((a, i) => (
          <li data-area-i={i}>
            <a href={`/research/${a.id}/`}>
              <h3>{a.data.title}</h3>
              <p>{a.data.summary}</p>
              <span class="count">{count(a.id) ? `${count(a.id)} publication${count(a.id) === 1 ? '' : 's'}` : 'New direction'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section tone demo" data-reveal>
    <div class="wrap demo-grid">
      <div class="demo-text">
        <h2>Ask the lab's data a question</h2>
        <p>Most of the world's data sits behind a query language that few people write. Our Text-to-SQL work turns plain questions into correct queries over real schemas, and teaches the system to say when it is not sure.</p>
        <p>Watch it work on this site's own publication records.</p>
        <a class="more" href="/research/text-to-sql/">Text-to-SQL and Data Interfaces</a>
      </div>
      <SqlDemo />
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="wrap split">
      <div>
        <div class="section-head"><h2>Latest news</h2><a class="more" href="/news/">All news</a></div>
        {news.map((n) => <NewsItem item={n} />)}
      </div>
      {upcoming.length > 0 && (
        <aside>
          <div class="section-head"><h2>Coming up</h2><a class="more" href="/events/">All events</a></div>
          {upcoming.slice(0, 3).map((e) => <EventItem event={e} />)}
        </aside>
      )}
    </div>
  </section>

  <section class="section tone" data-reveal>
    <div class="wrap">
      <div class="section-head">
        <div><h2>Our work over time</h2><p>{pubs.length} papers across {areas.length} research directions.</p></div>
        <a class="more" href="/publications/">All publications</a>
      </div>
      <div class="timeline"><PubTimeline /></div>
      <h3 class="sub">Selected papers</h3>
      <div class="pubs">{featured.map((p) => <PubItem pub={p} />)}</div>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section" data-reveal>
      <div class="wrap software">
        <div class="software-text">
          <h2>Software and data</h2>
          <p>Code, datasets and benchmarks from our papers, released so others can check our results and build on them.</p>
          <a class="more" href="/software/">Everything we release</a>
        </div>
        <ul class="releases" data-stagger>
          {projects.map((p) => (
            <li>
              <a href={`/software/${p.id}/`}>
                <h3>{p.data.title}{p.data.sample && <span class="sample-note">Sample</span>}</h3>
                <p>{p.data.summary}</p>
                <span class="kind">{PROJECT_KINDS[p.data.kind]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section people" data-reveal>
    <div class="wrap">
      <div class="section-head">
        <div><h2>The lab</h2><p>{current.length} members{alumni.length > 0 && `, ${alumni.length} alumni`}.</p></div>
        <a class="more" href="/people/">Everyone in the lab</a>
      </div>
      <ul class="faces" data-stagger>
        {current.map((p) => (
          <li>
            <a href={`/people/${p.id}/`}>
              <Avatar name={p.data.name} photo={p.data.photo} size={148} />
              <strong>{p.data.name}</strong>
              <span>{p.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <figure class="campus photo">
    <div class="frame"><img src={campus.file} alt={campus.caption} width="2000" height="1500" loading="lazy" decoding="async" /></div>
    <figcaption class="wrap">{campus.caption}. Room 821 of the Computer Engineering building is where we work.</figcaption>
  </figure>

  <section class="join-band">
    <div class="wrap join-grid">
      <div>
        <h2>{site.admissions?.accepting ? `We are taking students for ${site.admissions.cycle}` : 'We are not taking new students right now'}</h2>
        <p>{positions.length > 0 ? `${positions.length} open position${positions.length === 1 ? '' : 's'} for students who want to work between machine learning and data systems at ${site.university}.` : 'Check back later, or write to us about future openings.'}</p>
      </div>
      <div class="cta">
        <a class="btn primary" href="/join/">See open positions</a>
        <a class="btn" href={`mailto:${site.email}`}>Email the lab</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // The parts of each section (heading, then text, then figure) rise into
  // place one after another the first time the section scrolls into view.
  document.querySelectorAll<HTMLElement>('[data-reveal] .wrap > *, [data-stagger] > *').forEach((el) => {
    const i = [...el.parentElement!.children].indexOf(el);
    el.style.setProperty('--i', String(Math.min(i, 8)));
  });
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (e.isIntersecting) { e.target.classList.add('shown'); io.unobserve(e.target); }
  }), { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('[data-reveal]').forEach((s) => (reduced ? s.classList.add('shown') : io.observe(s)));
  // After a jump (anchor link, restored scroll) also show every section already passed.
  let rq = 0;
  addEventListener('scroll', () => { cancelAnimationFrame(rq); rq = requestAnimationFrame(() => {
    document.querySelectorAll('[data-reveal]:not(.shown)').forEach((s) => { if (s.getBoundingClientRect().top < innerHeight) s.classList.add('shown'); });
  }); }, { passive: true });
  document.documentElement.classList.add('js');

  // The flower leans gently towards the pointer.
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  const hero = document.querySelector<HTMLElement>('.hero');
  if (tilt && hero && !reduced && matchMedia('(pointer: fine)').matches) {
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = tilt.getBoundingClientRect();
        const dx = (e.clientX - (r.left + r.width / 2)) / r.width, dy = (e.clientY - (r.top + r.height / 2)) / r.height;
        tilt.style.transform = `perspective(900px) rotateY(${dx * 10}deg) rotateX(${-dy * 10}deg) rotate(${dx * 6}deg)`;
      });
    });
    hero.addEventListener('pointerleave', () => (tilt.style.transform = ''));
  }
</script>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: center; padding-top: clamp(48px, 7vw, 96px); padding-bottom: clamp(64px, 8vw, 112px); }
  .hero-art { transition: transform 0.6s var(--ease-out); will-change: transform; max-width: 620px; margin-right: -24px; justify-self: center; width: 100%; }
  .hero-text { position: relative; }
  h1 { font-size: clamp(3.5rem, 7.4vw, 7rem); font-weight: 300; line-height: 0.9; letter-spacing: -0.045em; margin-left: -0.04em; white-space: nowrap; }
  .statement { margin-top: clamp(24px, 3vw, 36px); font-size: clamp(1.3rem, 1rem + 0.9vw, 1.7rem); line-height: 1.3; letter-spacing: -0.01em; max-width: 24ch; color: var(--ink); }
  .statement a { color: inherit; text-decoration-color: var(--daisy); text-decoration-thickness: 2px; }
  .statement a:hover { text-decoration-thickness: 3px; }
  .intro { margin-top: 20px; font-size: var(--fs-md); color: var(--ink-2); max-width: 46ch; line-height: 1.6; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  @media (max-width: 900px) {
    .hero { display: flex; flex-direction: column; }
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .hero-art { max-width: 520px; margin-right: 0; }
    h1 { font-size: clamp(3.5rem, 18vw, 8rem); }
  }

  /* Research directions: one row per direction, title, summary, papers. */
  .areas { list-style: none; margin: 0 calc(-1 * min(20px, var(--gutter))); padding: 0; }
  .areas a { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) minmax(0, 1.6fr); gap: 8px 40px; align-items: baseline; padding: 26px 20px; color: var(--ink); text-decoration: none; transition: background-color 0.2s; }
  .areas h3 { font-size: clamp(1.25rem, 1rem + 0.7vw, 1.6rem); font-weight: 400; letter-spacing: -0.015em; line-height: 1.2; }
  .areas p { font-size: var(--fs-sm); color: var(--ink-2); max-width: 56ch; }
  .count { font-size: var(--fs-sm); color: var(--ink-2); text-align: right; white-space: nowrap; }
  .areas li.on a, .areas a:hover { background: var(--surface); }
  .areas li.on h3, .areas a:hover h3 { text-decoration: underline; text-decoration-color: var(--daisy); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  @media (max-width: 860px) {
    .areas a { grid-template-columns: minmax(0, 1fr); padding: 20px min(20px, var(--gutter)); }
    .count { text-align: left; }
  }

  /* Entrances: each part of a section rises in turn, once. */
  :global(html.js) [data-reveal] .wrap > *, :global(html.js) [data-reveal] [data-stagger] > * { opacity: 0; transform: translateY(22px); transition: opacity 0.7s var(--ease-out) calc(var(--i, 0) * 80ms), transform 0.8s var(--ease-out) calc(var(--i, 0) * 80ms); }
  :global(html.js) [data-reveal].shown .wrap > *, :global(html.js) [data-reveal].shown [data-stagger] > * { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { :global(html.js) [data-reveal] .wrap > *, :global(html.js) [data-reveal] [data-stagger] > * { opacity: 1; transform: none; } }

  .demo-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .demo-text h2 { font-size: var(--fs-2xl); font-weight: 300; letter-spacing: -0.03em; line-height: 1.05; max-width: 12ch; }
  .demo-text p { margin-top: 18px; color: var(--ink-2); max-width: 44ch; }
  .demo-text .more { display: inline-block; margin-top: 22px; }
  @media (max-width: 900px) { .demo-grid { grid-template-columns: minmax(0, 1fr); } }

  .timeline { margin-bottom: clamp(40px, 5vw, 64px); }
  .sub { font-size: var(--fs-lg); font-weight: 400; letter-spacing: -0.01em; margin-bottom: 8px; }

  .split { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); }
  .split > div:only-child { grid-column: 1 / -1; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }

  /* Software: the case for releasing on the left, the releases stacked on the right. */
  .software { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .software-text p { margin-top: 16px; color: var(--ink-2); max-width: 40ch; }
  .software-text .more { display: inline-block; margin-top: 20px; }
  .releases { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .releases a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 24px; padding: 24px 26px; background: var(--surface); color: var(--ink); text-decoration: none; transition: background-color 0.2s; }
  .releases a:hover { background: var(--surface-2); }
  .releases h3 { font-size: var(--fs-lg); font-weight: 400; letter-spacing: -0.01em; grid-column: 1; }
  .releases h3 .sample-note { margin-left: 10px; }
  .releases p { grid-column: 1; font-size: var(--fs-sm); color: var(--ink-2); }
  .releases .kind { grid-column: 2; grid-row: 1; font-size: var(--fs-sm); color: var(--ink-2); }
  @media (max-width: 900px) { .software { grid-template-columns: minmax(0, 1fr); } }

  .faces { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 32px 20px; }
  .faces a { display: flex; flex-direction: column; gap: 3px; color: var(--ink); text-decoration: none; }
  .faces a :global(.avatar) { width: 100%; height: auto; aspect-ratio: 1; margin-bottom: 12px; transition: filter 0.3s; }
  .faces a:hover :global(.avatar) { filter: saturate(1.15) contrast(1.05); }
  .faces strong { font-size: var(--fs-base); font-weight: 600; }
  .faces span { font-size: var(--fs-sm); color: var(--ink-2); }
  .faces a:hover strong { text-decoration: underline; text-decoration-color: var(--daisy); text-decoration-thickness: 2px; }

  /* The campus, full width, drifting slowly as the page scrolls past it. */
  .campus { padding-bottom: clamp(32px, 4vw, 48px); }
  .campus .frame { overflow: hidden; height: clamp(320px, 66vh, 760px); }
  .campus img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; }
  .campus figcaption { margin-top: 12px; font-size: var(--fs-sm); color: var(--ink-2); }
  @keyframes drift { from { transform: scale(1.14) translateY(-4%); } to { transform: scale(1.02) translateY(3%); } }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .campus img { animation-name: drift; animation-timing-function: linear; animation-fill-mode: both; }
      /* Kept as its own rule so the minifier cannot fold it into the shorthand. */
      .campus .frame > img { animation-timeline: view(); }
    }
  }

  .join-band { background: var(--daisy); color: #161719; }
  .join-grid { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px 64px; flex-wrap: wrap; padding-top: clamp(56px, 7vw, 96px); padding-bottom: clamp(56px, 7vw, 96px); }
  .join-band h2 { font-size: var(--fs-2xl); font-weight: 300; letter-spacing: -0.03em; line-height: 1.05; max-width: 18ch; }
  .join-band p { margin-top: 16px; max-width: 56ch; font-size: var(--fs-md); }
  .join-band .cta { margin-top: 0; }
  .join-band .btn { background: transparent; color: #161719; box-shadow: inset 0 0 0 2px #161719; }
  .join-band .btn.primary { background: #161719; color: var(--daisy); box-shadow: none; }
  .join-band .btn:hover { background: #161719; color: var(--daisy); }
  .join-band .btn.primary:hover { background: #fcfcfb; color: #161719; }
</style>
